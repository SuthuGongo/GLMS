<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    GLMS.Web: the MVC front end (Part 3 presentation layer).
    No EF Core package, no connection string and no reference to GLMS.Core: it only knows the API contract
    (GLMS.Shared) and reaches all data through GLMS.Api with HttpClient.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GLMS.Web</RootNamespace>
    <UserSecretsId>glms-web-st10545758</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GLMS.Shared\GLMS.Shared.csproj" />
  </ItemGroup>

</Project>
