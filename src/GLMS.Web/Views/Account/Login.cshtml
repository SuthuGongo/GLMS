@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<div class="login-wrap">
    <section class="card login-card">
        <div class="card-body">
            <h1>Sign in to GLMS</h1>
            <p class="small-muted">Your username and password are checked by the GLMS API, which issues a secure token for this session.</p>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign in</button>
            </form>

            <div class="demo-users small-muted mt-4">
                <div><b>Demo accounts</b></div>
                <div><code>admin</code> / <code>Admin@@12345</code> (can delete clients)</div>
                <div><code>manager</code> / <code>Manager@@12345</code></div>
            </div>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
