{
  "ConnectionStrings": {
    "GlmsDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=GLMS_Db;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "glms-api",
    "Audience": "glms-clients",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  "SeedUsers": {
    "AdminPassword": "Admin@12345",
    "ManagerPassword": "Manager@12345"
  },
  "CurrencyApi": {
    "Mode": "Live",
    "BaseUrl": "https://open.er-api.com/v6/latest/",
    "TimeoutSeconds": 8,
    "CacheMinutes": 60,
    "MaxStaleHours": 24,
    "FixedRates": {
      "USD-ZAR": 18.50,
      "EUR-ZAR": 20.10
    }
  },
  "FileStorage": {
    "RootPath": "App_Data/agreements"
  },
  "ContractExpiry": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Https": {
    "Redirect": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
