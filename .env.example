# Copy to ".env" (git-ignored) to override the demo defaults in docker-compose.yml.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol. Avoid "$" in values.
SA_PASSWORD=Glms_Strong!Passw0rd
# At least 32 characters.
JWT_SIGNING_KEY=replace-with-a-long-random-secret-of-32-plus-chars
ADMIN_PASSWORD=Admin@12345
MANAGER_PASSWORD=Manager@12345
# Live (real exchange rates, needs internet) or Fixed (offline demo rates from appsettings.json)
CURRENCY_MODE=Live
